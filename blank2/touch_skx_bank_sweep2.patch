          "  --validate         run uncore iMC CAS-read counter validation on one address\n"
          "  --validate-bank    bank_id (0..15) to validate (default: best bank)\n"
          "  --validate-idx     index within that bank vector (default: 0)\n"
          "  --validate-iters   flush+load iterations (default: 20000; clamped for safety)\n"
          "  --validate-all-imcs  also open counters for all uncore_imc_* and print all deltas\n",
          argv0);
  }
